{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Online Bookstore",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Reader\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List all books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=8",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "8" }
              ]
            }
          }
        },
        {
          "name": "Get distinct genres",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books/genres",
              "host": ["{{baseUrl}}"],
              "path": ["books", "genres"]
            }
          }
        },
        {
          "name": "Search books by title/author",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?search=tolkien&page=1&limit=8",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "search", "value": "tolkien" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "8" }
              ]
            }
          }
        },
        {
          "name": "Filter by genre",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?genre=fantasy&page=1&limit=8",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "genre", "value": "fantasy" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "8" }
              ]
            }
          }
        },
        {
          "name": "Filter by author (partial)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?author=orwell&page=1&limit=8",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "author", "value": "orwell" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "8" }
              ]
            }
          }
        },
        {
          "name": "Filter by price range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?minPrice=200&maxPrice=500&page=1&limit=8",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "minPrice", "value": "200" },
                { "key": "maxPrice", "value": "500" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "8" }
              ]
            }
          }
        },
        {
          "name": "Sort by price ascending",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?sort=price&page=1&limit=8",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "sort", "value": "price" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "8" }
              ]
            }
          }
        },
        {
          "name": "Sort by title descending",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?sort=-title&page=1&limit=8",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "sort", "value": "-title" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "8" }
              ]
            }
          }
        },
        {
          "name": "Get single book",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books/:id",
              "host": ["{{baseUrl}}"],
              "path": ["books", ":id"],
              "variable": [
                { "key": "id", "value": "REPLACE_WITH_BOOK_ID" }
              ]
            }
          }
        },
        {
          "name": "Add book (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Lord of the Rings\",\n  \"author\": \"J.R.R. Tolkien\",\n  \"genre\": \"Fantasy\",\n  \"price\": 899,\n  \"stock\": 15,\n  \"language\": \"English\",\n  \"pages\": 1178,\n  \"isbn\": \"9780618640157\",\n  \"coverImage\": \"https://covers.openlibrary.org/b/isbn/9780618640157-L.jpg\",\n  \"description\": \"Frodo Baggins is entrusted with the One Ring and must journey across Middle-earth to destroy it in the fires of Mount Doom.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "Update book (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 799,\n  \"stock\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/:id",
              "host": ["{{baseUrl}}"],
              "path": ["books", ":id"],
              "variable": [
                { "key": "id", "value": "REPLACE_WITH_BOOK_ID" }
              ]
            }
          }
        },
        {
          "name": "Delete book (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/:id",
              "host": ["{{baseUrl}}"],
              "path": ["books", ":id"],
              "variable": [
                { "key": "id", "value": "REPLACE_WITH_BOOK_ID" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"REPLACE_WITH_BOOK_ID\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        }
      ]
    }
  ]
}
